---
layout: null
---
{"files":[
{%- assign sep = "" -%}
{%- for file in site.static_files -%}
{%- assign ext = file.extname | downcase -%}
{%- if file.path contains '/albums/' -%}
{%- if ext == '.jpg' or ext == '.jpeg' or ext == '.png' or ext == '.webp' or ext == '.gif' or ext == '.avif' or ext == '.mp4' or ext == '.webm' or ext == '.mov' -%}
{{ sep }}{"path": {{ file.path | jsonify }}}
{%- assign sep = "," -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
]}